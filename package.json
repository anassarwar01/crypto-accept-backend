{
  "name": "my-nest-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeders/seed-runner.ts",
    "migration:run": "node -r ./tsconfig-paths-bootstrap.js -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d data-source.cjs",
    "migration:revert": "node -r ./tsconfig-paths-bootstrap.js -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d data-source.cjs",
    "migration:status": "node -r ./tsconfig-paths-bootstrap.js -r ts-node/register ./node_modules/typeorm/cli.js migration:show -d data-source.cjs",
    "migration:generate": "node -r ./tsconfig-paths-bootstrap.js -r ts-node/register ./node_modules/typeorm/cli.js migration:generate -d data-source.cjs",
    "migration:create": "node -r ./tsconfig-paths-bootstrap.js -r ts-node/register ./node_modules/typeorm/cli.js migration:create",
    "cron:rates": "ts-node -r tsconfig-paths/register src/cron/conversion-rate/trigger-rates.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.10",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.11",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.28",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@users/(.*)$": "<rootDir>/modules/users/$1",
      "^@merchants/(.*)$": "<rootDir>/modules/merchants/$1",
      "^@merchant-settings/(.*)$": "<rootDir>/modules/merchant-settings/$1",
      "^@merchant-customers/(.*)$": "<rootDir>/modules/merchant-customers/$1",
      "^@customers/(.*)$": "<rootDir>/modules/customers/$1",
      "^@transactions/(.*)$": "<rootDir>/modules/transactions/$1",
      "^@cryptocurrency/(.*)$": "<rootDir>/modules/cryptocurrency/$1",
      "^@database/data-source$": "<rootDir>/../data-source.ts",
      "^@helper/(.*)$": "<rootDir>/helper/$1",
      "^@crypto-transactions/(.*)$": "<rootDir>/modules/crypto-transactions/$1",
      "^@system-settings/(.*)$": "<rootDir>/modules/system-settings/$1",
      "^@feature-flags/(.*)$": "<rootDir>/modules/feature-flags/$1",
      "^@external-services/(.*)$": "<rootDir>/modules/external-services/$1",
      "^@common/(.*)$": "<rootDir>/modules/common/$1",
      "^@cron/(.*)$": "<rootDir>/cron/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    }
  }
}