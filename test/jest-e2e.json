{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "globalTeardown": "<rootDir>/teardown.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@users/(.*)$": "<rootDir>/../src/modules/users/$1",
    "^@merchants/(.*)$": "<rootDir>/../src/modules/merchants/$1",
    "^@merchant-settings/(.*)$": "<rootDir>/../src/modules/merchant-settings/$1",
    "^@customers/(.*)$": "<rootDir>/../src/modules/customers/$1",
    "^@transactions/(.*)$": "<rootDir>/../src/modules/transactions/$1",
    "^@cryptocurrency/(.*)$": "<rootDir>/../src/modules/cryptocurrency/$1",
    "^@database/data-source$": "<rootDir>/../data-source.ts",
    "^@helper/(.*)$": "<rootDir>/../src/helper/$1",
    "^@crypto-transactions/(.*)$": "<rootDir>/../src/modules/crypto-transactions/$1",
    "^@system-settings/(.*)$": "<rootDir>/../src/modules/system-settings/$1",
    "^@feature-flags/(.*)$": "<rootDir>/../src/modules/feature-flags/$1",
    "^@external-services/(.*)$": "<rootDir>/../src/modules/external-services/$1",
    "^@merchant-customers/(.*)$": "<rootDir>/../src/modules/merchant-customers/$1",
    "^@common/(.*)$": "<rootDir>/../src/modules/common/$1",
    "^@cron/(.*)$": "<rootDir>/../src/cron/$1",
    "^@test/(.*)$": "<rootDir>/../test/$1"
  }
}